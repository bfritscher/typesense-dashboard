{
  "name": "typesense-dashboard",
  "version": "2.5.0",
  "description": "A Typesense Dashboard to manage and browse collections.",
  "productName": "Typesense-Dashboard",
  "author": "Boris Fritscher <boris@fritscher.ch>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:desktop": "quasar dev -m electron --devtools",
    "build": "quasar build",
    "build:desktop": "quasar build -m electron --target all",
    "postinstall": "quasar prepare",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@quasar/extras": "2.0.2",
    "axios": "1.18.1",
    "file-saver": "2.0.5",
    "instantsearch.css": "8.18.0",
    "monaco-editor": "0.56.0",
    "nanoid": "6.0.0",
    "pinia": "4.0.2",
    "pretty-bytes": "7.1.1",
    "quasar": "2.22.0",
    "typesense": "3.0.6",
    "typesense-instantsearch-adapter": "3.0.2",
    "vue": "3.5.40",
    "vue-instantsearch": "4.28.0",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@quasar/app-vite": "3.2.0",
    "@types/file-saver": "2.0.7",
    "@types/node": "26.1.1",
    "@vue/devtools": "8.1.5",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vite-plugin-checker": "0.14.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.8"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
